    "crew_ceiling": 400,
    "maintenance_step": 100
  },
  "month_order": [
    "observe k_t",
    "choose maintenance M_t, a multiple of maintenance_step with 0 <= M_t <= crew_ceiling (jointly over units)",
    "if k_t >= k_lettable_min: collect rent and pay running cost; otherwise neither",
    "pay M_t",
    "k_{t+1} = max(k_min, min(k_max, k_t - d(k_t) + M_t / money_per_tenth))"
  ],
  "surplus": "pi_t = (rent - running_cost) * [k_t >= k_lettable_min] - M_t",
